#!/usr/bin/env sh

# Git hooks may run with a minimal PATH (especially from GUI apps on macOS).
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$HOME/.asdf/shims:$PATH"

if ! command -v npm >/dev/null 2>&1; then
	# Load nvm lazily when npm is not already available.
	if [ -s "$HOME/.nvm/nvm.sh" ]; then
		. "$HOME/.nvm/nvm.sh"
	fi
fi

if ! command -v npm >/dev/null 2>&1; then
	echo "pre-commit: npm not found. Ensure Node.js/npm is installed and available to Git hooks." >&2
	exit 1
fi

# Biome rewrites files in the working tree, so remember what the author staged and re-stage it
# afterwards to keep the fixes in the commit. Files with unstaged edits (git add -p) are skipped so
# hunks the author left out are never pulled in.
restage="$(mktemp)"
trap 'rm -f "$restage"' EXIT
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
	if git diff --quiet -- "$file"; then
		printf '%s\n' "$file"
	fi
done >"$restage"

# Run formatting/lint/integrity + preview generation
npm run precommit || exit 1

while IFS= read -r file; do
	git add -- "$file"
done <"$restage"

# Stage generated assets updated by scripts so commit includes them
git add preview/ src/symbol-icon-theme.json README.md
